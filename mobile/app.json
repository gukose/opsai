{
  "expo": {
    "name": "Hotel OpAI",
    "slug": "hotel-opai-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.hotelopai.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Hotel OpAI uses the microphone only when you record an operational request."
      }
    },
    "android": {
      "package": "com.hotelopai.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Hotel OpAI to record operational voice requests."
        }
      ]
    ]
  }
}
