{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/unimock/Dockerfile",
    "watchPatterns": [
      "/unimock/**",
      "/gradle/**",
      "/gradlew",
      "/build.gradle.kts",
      "/settings.gradle.kts"
    ]
  },
  "deploy": {
    "healthcheckPath": "/actuator/health",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
